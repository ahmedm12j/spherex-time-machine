{
  "name": "SPHEREx Time Machine (4-core / 16 GB)",
  // 16 GB is the point: the 2-core default machine has 8 GB and cannot hold the
  // full blink sequence. Codespaces creates the machine that satisfies
  // hostRequirements, so the 4-core / 16 GB box is selected automatically.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "SPHEREx Time Machine",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "deploy/CODESPACES.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  }
}
